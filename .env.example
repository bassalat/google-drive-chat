# Anthropic API Key
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend Configuration (for production)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Python Environment
# Path to Python interpreter (for MCP server)
# Default: python3 (uses system Python)
# You can specify a specific path, e.g., /path/to/venv/bin/python
PYTHON_PATH=python3

# Google Drive Configuration
# OAuth credentials are managed in .drive-data/ directory
# Run /drive-setup to configure
